# Copy to .env.local. Never commit real values.
# Browser-safe (anon key only; RLS protects data)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server functions only. Must never be prefixed VITE_ or reach the client bundle.
SUPABASE_DB_URL=
SUPABASE_JWT_SECRET=
# Outcome encryption keys: keyId:base64(32 random bytes), comma-separated; the first encrypts new records.
OUTCOME_KEYS=
# Local DB tests (scripts/db-test.sh): an admin connection to a disposable Postgres 16 + PostGIS server
DATABASE_URL=
# API integration tests (server/test): admin connection that may create databases
TEST_DATABASE_URL=
